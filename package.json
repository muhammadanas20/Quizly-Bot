{
  "name": "quizly-bot",
  "version": "2.0.0",
  "description": "WhatsApp quiz solver + silent sticker guard for flagged members. Built for a 1 GB RAM VM (no Chromium).",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test \"test/*.test.js\"",
    "check": "node scripts/check-env.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:logs": "pm2 logs quizly --lines 100"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "dotenv": "^16.6.1",
    "qrcode-terminal": "^0.12.0"
  },
  "optionalDependencies": {
    "sharp": "^0.34.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "quiz",
    "gemini",
    "grok",
    "moderation"
  ],
  "license": "MIT"
}

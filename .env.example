# ══════════════════════════════════════════════════════════════════════════════
#  QUIZLY BOT — configuration
#  Copy this file to .env  →  cp .env.example .env  →  fill in your keys
#  NEVER commit .env. It holds API keys and the numbers that control your bot.
# ══════════════════════════════════════════════════════════════════════════════

# ─── 1. WHO OWNS THE BOT ──────────────────────────────────────────────────────
# Only these numbers can run !flag / !unflag / !guard or the global
# !game on / !game stop / !game reset tops controls.
# International format, digits only, no "+" and no spaces. Comma separated.
# Commands typed from the bot's OWN account are always accepted as owner
# commands — you can drive the bot straight from the phone it runs on.
OWNER_NUMBERS=923001234567

# Your bot's own WhatsApp number (only needed if you want PAIRING CODE login
# instead of scanning a QR code in the terminal).
# PHONE_NUMBER=923001234567

# ─── 2. AI PROVIDERS ──────────────────────────────────────────────────────────
# Order the bot tries them in. First one with a key wins; on failure it falls
# through to the next. Groq is first because it is the fastest (about a second
# per quiz image); Gemini and Grok follow as the heavier hitters.
AI_ORDER=groq,gemini,grok

# Google Gemini — free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 0 = no thinking tokens = fastest + cheapest. Only applied to 2.5-* models.
GEMINI_THINKING_BUDGET=0

# xAI Grok — key: https://console.x.ai/team/default/api-keys
# List the models YOUR key can use:  npm run check
XAI_API_KEY=
XAI_MODEL=grok-4.5
# low = fastest. medium/high = smarter but slower and pricier.
XAI_REASONING_EFFORT=low

# Groq (primary by default — fastest of the three, ~1s per quiz image)
# key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Per-request timeout in ms, and per-provider model fallbacks.
# If a model id gets retired by the provider, the next one in the list is tried
# automatically, so a renamed model never takes the bot down.
AI_TIMEOUT_MS=60000
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash-lite,gemini-2.0-flash
XAI_MODEL_FALLBACKS=grok-4.3,grok-4-fast-non-reasoning
GROQ_MODEL_FALLBACKS=

# Max output tokens. 2400 comfortably covers a 30-question quiz; it is a
# ceiling, not a target, so a short answer costs nothing extra.
AI_MAX_TOKENS=2400

# ─── 3. QUIZ TRIGGER ─────────────────────────────────────────────────────────
# Message must contain this word AND carry an image (or reply to one).
QUIZ_TRIGGER=quiz
# Also accept the trigger in private (1-on-1) chats with the bot.
ALLOW_PRIVATE=true
# What the bot does while it thinks: react | text | none
# react = adds a 👀 to your message. Fast, zero spam.
ACK_MODE=react

# ─── 4. MEDIA GUARD (silent removal for flagged members) ──────────────────────
# on  = delete, no warning, no reply (default)
# off = disabled everywhere
STICKER_GUARD=on

# Which media types are removed from a flagged member. Comma separated.
# By default, stickers and photos are removed. View-once photos count as images.
#   sticker | image | video | gif | audio | document | link | viewonce | all
# "viewonce" is a one-time message whose media WhatsApp withheld, so its real type
# is unknown; any image/video/audio rule already covers it. GUARD_MEDIA=sticker on
# its own is an explicit stickers-only policy and leaves one-time media alone.
GUARD_MEDIA=sticker,image

# Pre-seed the flag list from code. Same formats as !flag accepts:
#   923001234567  |  +92 300 1234567  |  923001234567@s.whatsapp.net
# Separate entries with commas. Names after a colon are optional labels.
#   FLAGGED_USERS=923001234567:Ali,923009876543
FLAGGED_USERS=

# Never remove media from these numbers, even if they are flagged (safety net
# so you can never lock yourself or a co-admin out).
GUARD_WHITELIST=

# ─── 5. GAMES (!game, !guess, !top) ───────────────────────────────────────────
# Every member can play when the owner enables games. Scores live in
# DATA_DIR/scores.json and survive restarts.
# Initial state only: owner !game on / !game stop overrides it persistently.
# Even with GAMES=off, the owner can send !game on from WhatsApp.
GAMES=on

# How long a round stays open before the answer is revealed (seconds).
# A busy group needs less time, a quiet one more.
GAME_TIMEOUT=180

# Breather before the same chat can start another round (seconds); capped at
# 5 even if an old config says 15. Participation points still have a separate
# minimum 5-second anti-farming window if the breather is set shorter.
GAME_COOLDOWN=5

# How many guesses one member gets per round (slots is always one pick each).
GAME_MAX_ATTEMPTS=12

# A background text-only request uses your configured AI provider order to
# make fresh trivia and scramble puzzles every 24h, starting on boot (or when
# games are first enabled). The bounded AI pool is saved to
# DATA_DIR/game-content.json and REPLACES the previous generated pool on success.
# Failed/invalid responses keep the previous pool and retry with backoff;
# built-in questions, member submissions and scores are never removed.
# Counts are capped at 32 each to protect memory / API quota.
GAME_AI_TRIVIA_COUNT=16
GAME_AI_PUZZLE_COUNT=16

# ─── 6. RATE LIMITS (protects your free API quota) ────────────────────────────
RATE_PER_MINUTE=12
RATE_PER_DAY=800

# ─── 7. RUNTIME / PATHS ──────────────────────────────────────────────────────
# Identity this bot pairs as. WhatsApp only sends ONE-TIME ("view once") media to
# a phone-class linked device; a web-class one gets the message with the media
# withheld. The guard still revokes those on web-class devices, straight from
# the raw message stanza — a revoke needs only the message key.
#   web     default, keeps your current pairing valid
#   android phone-class, so one-time media arrives too — REQUIRES PAIRING AGAIN
WA_BROWSER=web
# Device name shown in WhatsApp → Linked devices when WA_BROWSER=android.
WA_BROWSER_NAME=Quizly Bot

SESSION_DIR=./auth
DATA_DIR=./data
LOG_LEVEL=info
